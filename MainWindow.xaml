<Window x:Class="GraphicEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Графический редактор"
        Height="620" Width="960"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F3F3F3" BorderBrush="#D0D0D0" BorderThickness="1" Padding="8" Margin="0,0,0,10">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Инструмент:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <RadioButton x:Name="PencilRadio" Content="Карандаш" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0" Checked="ToolRadio_Checked"/>
                <RadioButton x:Name="LineRadio" Content="Линия" VerticalAlignment="Center" Margin="0,0,10,0" Checked="ToolRadio_Checked"/>
                <RadioButton x:Name="RectangleRadio" Content="Прямоугольник" VerticalAlignment="Center" Margin="0,0,10,0" Checked="ToolRadio_Checked"/>
                <RadioButton x:Name="EllipseRadio" Content="Эллипс" VerticalAlignment="Center" Margin="0,0,20,0" Checked="ToolRadio_Checked"/>

                <TextBlock Text="Цвет:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="ColorBox" Width="110" VerticalAlignment="Center" Margin="0,0,16,0" SelectionChanged="ColorBox_SelectionChanged"/>

                <TextBlock Text="Толщина:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="ThicknessBox" Width="65" VerticalAlignment="Center" Margin="0,0,20,0" SelectionChanged="ThicknessBox_SelectionChanged"/>

                <Button Content="Очистить холст" Width="120" Margin="0,0,8,0" Click="ClearButton_Click"/>
                <Button Content="Сохранить изображение" Width="160" Click="SaveButton_Click"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="1" BorderBrush="#888888" BorderThickness="1">
            <Canvas x:Name="DrawingCanvas"
                    Background="White"
                    ClipToBounds="True"
                    Cursor="Cross"
                    MouseLeftButtonDown="DrawingCanvas_MouseLeftButtonDown"
                    MouseMove="DrawingCanvas_MouseMove"
                    MouseLeftButtonUp="DrawingCanvas_MouseLeftButtonUp"
                    MouseLeave="DrawingCanvas_MouseLeave"/>
        </Border>
    </Grid>
</Window>